<li id="checklist_item_<%= checklist_item.id %>" class="<%= 'checklist-section-item' if checklist_item.is_section %> <%= 'is-done-checklist-item' if checklist_item.is_done %>">
  <% if checklist_item.is_section %>
    <span class="checklist-section-title"><strong><%= checklist_item.subject.strip %></strong></span>
  <% else %>
    <%= check_box_tag 'checklist_item', '1', checklist_item.is_done,
        disabled: !User.current.allowed_to?(:done_checklists, checklist_item.issue.project),
        onclick:  "checklist_item_done(this,'#{url_for({ controller: 'issue_checklists', action: 'done', checklist_item_id: checklist_item.id, is_done: (checklist_item.is_done == false) })}','#{checklist_item.id}')"
    %>
    <span class="checklist-item-subject"><%= textilizable(checklist_item, :subject).delete_prefix('<p>').delete_suffix('</p>').strip.html_safe %></span>

    <% if checklist_item.assigned_to.present? %>
      <span class="checklist-pill checklist-pill-assignee" title="<%= l(:field_assigned_to) %>">
        <%= avatar(checklist_item.assigned_to, size: "14") rescue '' %>
        <%= checklist_item.assigned_to.name %>
      </span>
    <% end %>

    <% if checklist_item.due_date.present? %>
      <span class="checklist-pill checklist-pill-due <%= 'checklist-pill-overdue' if checklist_item.due_date < Date.today && !checklist_item.is_done %>" title="<%= l(:field_due_date) %>">
        &#128197; <%= format_date(checklist_item.due_date) %>
      </span>
    <% end %>
  <% end %>

  <span class="checklist-item-actions">
    <% if !checklist_item.is_section && User.current.allowed_to?(:log_time, checklist_item.issue.project) %>
      <a href="#" onclick="openLogTimeModal('<%= checklist_item.id %>', '<%= escape_javascript(checklist_item.subject) %>'); return false;"
         class="icon icon-time" title="<%= l(:button_log_time) %>"></a>
    <% end %>

    <% if User.current.allowed_to?(:edit_checklists, checklist_item.issue.project) %>
      <%= link_to '', { controller: 'issue_checklists', action: 'delete', checklist_item_id: checklist_item.id },
                  remote: true, method: :post,
                  class: 'delete icon icon-del', title: l(:button_delete) %>
    <% end %>
  </span>
</li>
