<% content_for :header_tags do %>
  <%= javascript_include_tag 'jquery.klass.js', plugin: 'redmine_issue_checklist' %>
  <%= javascript_include_tag 'jquery.ui.touch-punch.min.js', plugin: 'redmine_issue_checklist' %>
  <%= javascript_include_tag 'issue_checklist.jquery.js', plugin: 'redmine_issue_checklist' %>
  <%= stylesheet_link_tag :issue_checklist, plugin: 'redmine_issue_checklist' %>
<% end %>

<% if !@issue.blank? && User.current.allowed_to?(:view_checklists, @project) %>
  <%
    items = @issue.checklist.reject(&:is_section)
    total_items = items.size
    done_items = items.select(&:is_done).size
    percent = total_items > 0 ? (done_items.to_f / total_items * 100).round : 0
  %>
  <hr/>
  <div id="issue_checklist" class="box issue-checklist-container">
    <div class="checklist-header-row">
      <div class="checklist-title-area">
        <strong><%= l(:label_issue_checklist_plural) %></strong>
        <span class="checklist-count-badge badge <%= percent == 100 ? 'badge-success' : 'badge-info' %>">
          <%= done_items %>/<%= total_items %> (<%= percent %>%)
        </span>
      </div>

      <div class="checklist-actions-area">
        <% 
          settings = RedmineIssueChecklist.settings
          enable_bulk = settings.is_a?(Hash) ? (settings[:enable_bulk_actions].to_s != '0' && settings['enable_bulk_actions'].to_s != '0') : true
        %>
        <% if enable_bulk && total_items > 0 && User.current.allowed_to?(:done_checklists, @project) %>
          <%= link_to l(:button_check_all), issue_bulk_toggle_checklist_path(@issue, status: 'done'), method: :post, remote: true, class: 'checklist-toggle-btn', title: l(:label_checklist_mark_all_done) %>
          <%= link_to l(:button_uncheck_all), issue_bulk_toggle_checklist_path(@issue, status: 'open'), method: :post, remote: true, class: 'checklist-toggle-btn', title: l(:label_checklist_mark_all_open) %>
        <% end %>
        <a href="#" id="toggle_completed_checklists_btn" class="checklist-toggle-btn">
          <%= l(:label_checklist_hide_completed) %>
        </a>
        <%= link_to l(:button_export), issue_export_checklist_path(@issue), class: 'checklist-toggle-btn', title: l(:label_checklist_export_md) %>
        <% if User.current.allowed_to?(:edit_checklists, @project) %>
          <a href="#" id="open_checklist_import_modal_btn" class="checklist-toggle-btn">
            <%= l(:label_checklist_import_preview) %>...
          </a>
          <a href="#" onclick="$('#checklist_clone_box').toggle(); return false;" class="checklist-toggle-btn">
            <%= l(:button_copy) %>...
          </a>
        <% end %>
      </div>
    </div>

    <% if total_items > 0 %>
      <div class="checklist-progress-track">
        <div class="checklist-progress-fill" style="width: <%= percent %>%;"></div>
      </div>
    <% end %>

    <% if User.current.allowed_to?(:edit_checklists, @project) %>
      <div id="checklist_clone_box" style="display:none; margin-bottom: 12px; padding: 8px; background: #f6f8fa; border: 1px solid #e1e4e8; border-radius: 4px;">
        <%= form_with url: issue_clone_checklist_path(@issue), method: :post, local: true do |f| %>
          <span><%= l(:label_checklist_clone_from_issue) %>: #</span>
          <input type="number" name="source_issue_id" size="8" style="width: 80px;" placeholder="ID" required />
          <button type="submit" class="button-small"><%= l(:button_apply) %></button>
        <% end %>
      </div>
    <% end %>

    <ul id="issue_checklist_items" class="checklist-view-list">
      <% @issue.checklist.each do |checklist_item| %>
        <%= render partial: 'issue_checklists/checklist_item', object: checklist_item %>
      <% end %>
    </ul>

    <% if User.current.allowed_to?(:edit_checklists, @project) %>
      <div class="checklist-quick-add-bar">
        <%= form_with url: issue_quick_add_checklist_path(@issue), method: :post, id: 'checklist_quick_add_form', local: false do |f| %>
          <div class="quick-add-input-group">
            <input type="text" name="subject" id="quick_add_checklist_input" placeholder="<%= l(:text_checklist_quick_add_placeholder) %>" class="quick-add-field" autocomplete="off" required />

            <select name="assigned_to_id" class="quick-add-select" title="<%= l(:field_assigned_to) %>">
              <option value=""><%= l(:field_assigned_to) %>...</option>
              <% @project.assignable_users.each do |u| %>
                <option value="<%= u.id %>"><%= u.name %></option>
              <% end %>
            </select>

            <input type="date" name="due_date" class="quick-add-date" title="<%= l(:field_due_date) %>" />

            <% if User.current.allowed_to?(:add_issues, @project) %>
              <select name="create_mode" class="quick-add-select" title="<%= l(:label_checklist_create_mode) %>">
                <option value="checklist"><%= l(:label_checklist_mode_task) %></option>
                <option value="sub_issue">&#10133; <%= l(:label_checklist_mode_sub_issue) %></option>
              </select>
            <% end %>

            <label class="quick-add-section-label" title="<%= l(:text_checklist_section_info) %>">
              <input type="checkbox" name="is_section" value="1" id="quick_add_is_section" />
              <span><%= l(:label_checklist_is_section) %></span>
            </label>

            <button type="submit" class="button-small button-primary"><%= l(:button_add) %></button>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Import from TXT/MD Preview Modal %>
  <div id="checklist_import_modal" class="checklist-modal-backdrop" style="display:none;">
    <div class="checklist-modal-dialog">
      <div class="checklist-modal-header">
        <h3><%= l(:label_checklist_import_modal_title) %></h3>
        <button type="button" class="checklist-modal-close" onclick="closeChecklistImportModal();">&times;</button>
      </div>
      <div class="checklist-modal-body">
        <p class="checklist-modal-desc"><%= l(:text_checklist_import_desc) %></p>
        
        <div class="checklist-file-dropzone" id="checklist_file_dropzone">
          <input type="file" id="checklist_import_file_input" accept=".txt,.md,text/plain,text/markdown" style="display:none;" />
          <button type="button" class="button-small" onclick="$('#checklist_import_file_input').click();">
            <%= l(:button_choose_file) %> (.txt / .md)
          </button>
          <span id="checklist_import_filename" style="margin-left: 10px; font-weight: 600; color: #586069;"></span>
        </div>

        <div id="checklist_import_preview_area" style="display:none; margin-top: 14px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <strong><%= l(:label_checklist_preview) %>:</strong>
            <span id="checklist_preview_counts" class="info"></span>
          </div>

          <div class="checklist-preview-list-container">
            <table class="list checklist-preview-table" id="checklist_preview_table">
              <thead>
                <tr>
                  <th width="30"><input type="checkbox" id="checklist_preview_check_all" checked /></th>
                  <th width="70"><%= l(:field_type) %></th>
                  <th><%= l(:field_subject) %></th>
                </tr>
              </thead>
              <tbody id="checklist_preview_table_body">
              </tbody>
            </table>
          </div>

          <div style="margin-top: 10px; display: flex; align-items: center; gap: 15px;">
            <label>
              <input type="radio" name="import_action_mode" value="append" checked />
              <%= l(:label_checklist_import_append) %>
            </label>
            <label>
              <input type="radio" name="import_action_mode" value="replace" />
              <%= l(:label_checklist_import_replace) %>
            </label>
          </div>
        </div>
      </div>
      <div class="checklist-modal-footer">
        <button type="button" class="button-small" onclick="closeChecklistImportModal();"><%= l(:button_cancel) %></button>
        <button type="button" id="confirm_checklist_import_btn" class="button-small button-primary" style="display:none;" onclick="applyChecklistImportToIssue('<%= @issue.id %>');">
          <%= l(:button_import) %>
        </button>
      </div>
    </div>
  </div>

  <%# Log Time Modal for Checklist Item %>
  <div id="checklist_log_time_modal" class="checklist-modal-backdrop" style="display:none;">
    <div class="checklist-modal-dialog" style="width: 480px;">
      <div class="checklist-modal-header">
        <h3><%= l(:button_log_time) %></h3>
        <button type="button" class="checklist-modal-close" onclick="closeLogTimeModal();">&times;</button>
      </div>
      <%= form_with url: '', method: :post, id: 'checklist_log_time_form', local: false do |f| %>
        <div class="checklist-modal-body box tabular">
          <p>
            <label><%= l(:field_subject) %></label>
            <strong id="log_time_item_title"></strong>
          </p>
          <p>
            <label><%= l(:field_hours) %><span class="required"> *</span></label>
            <input type="number" step="0.25" min="0.1" name="hours" id="log_time_hours" required size="6" placeholder="1.0" />
          </p>
          <p>
            <label><%= l(:field_activity) %></label>
            <select name="activity_id">
              <% TimeEntryActivity.shared.active.each do |act| %>
                <option value="<%= act.id %>"><%= act.name %></option>
              <% end %>
            </select>
          </p>
          <p>
            <label><%= l(:field_spent_on) %></label>
            <input type="date" name="spent_on" value="<%= Date.today.to_s %>" />
          </p>
          <p>
            <label><%= l(:field_comments) %></label>
            <input type="text" name="comments" id="log_time_comments" size="40" />
          </p>
        </div>
        <div class="checklist-modal-footer">
          <button type="button" class="button-small" onclick="closeLogTimeModal();"><%= l(:button_cancel) %></button>
          <button type="submit" class="button-small button-primary"><%= l(:button_save) %></button>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
