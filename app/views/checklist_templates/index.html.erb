<div class="contextual">
  <%= link_to l(:label_checklist_template_new), new_checklist_template_path, class: 'icon icon-add' %>
  <% if User.current.admin? %>
    <%= link_to l(:label_checklist_category_plural), checklist_template_categories_path, class: 'icon icon-settings' %>
  <% end %>
</div>

<h2><%= l(:label_checklist_template_plural) %></h2>

<% 
  settings = RedmineIssueChecklist.settings
  enable_cat_filter = settings.is_a?(Hash) ? (settings[:enable_template_category_filter].to_s != '0' && settings['enable_template_category_filter'].to_s != '0') : true
%>
<% if enable_cat_filter && @categories.any? %>
  <fieldset class="box" style="margin-bottom: 12px; padding: 8px 12px;">
    <legend><%= l(:label_filter_plural) %></legend>
    <form method="get" action="<%= @project ? project_checklist_templates_path(@project) : checklist_templates_path %>">
      <label for="category_id"><strong><%= l(:field_category) %>:</strong></label>
      <select name="category_id" id="category_id" onchange="this.form.submit();" style="margin: 0 8px;">
        <option value=""><%= "--- #{l(:label_all)} ---" %></option>
        <% @categories.each do |cat| %>
          <option value="<%= cat.id %>" <%= 'selected="selected"' if @selected_category_id == cat.id.to_s %>><%= cat.name %></option>
        <% end %>
      </select>
      <% if @selected_category_id.present? %>
        <%= link_to l(:button_clear), @project ? project_checklist_templates_path(@project) : checklist_templates_path, class: 'icon icon-reload' %>
      <% end %>
    </form>
  </fieldset>
<% end %>

<% if @templates.any? %>
  <table class="list">
    <thead>
      <tr>
        <th><%= l(:field_name) %></th>
        <th><%= l(:field_category) %></th>
        <th><%= l(:field_tracker) %></th>
        <th><%= l(:field_is_default) %></th>
        <th><%= l(:field_is_public) %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @templates.each do |template| %>
        <tr class="<%= cycle('odd', 'even') %>">
          <td><%= link_to template.name, edit_checklist_template_path(template) %></td>
          <td><%= template.category ? template.category.name : '-' %></td>
          <td><%= template.tracker ? template.tracker.name : l(:label_all) %></td>
          <td><%= checked_image template.is_default? %></td>
          <td><%= checked_image template.is_public? %></td>
          <td class="buttons">
            <%= link_to l(:button_edit), edit_checklist_template_path(template), class: 'icon icon-edit' %>
            <%= link_to l(:button_delete), checklist_template_path(template), data: { confirm: l(:text_are_you_sure) }, method: :delete, class: 'icon icon-del' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
