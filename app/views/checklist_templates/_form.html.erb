<div class="box tabular">
  <p><%= f.text_field :name, required: true, size: 60 %></p>
  <p><%= f.select :category_id, options_from_collection_for_select(@categories, :id, :name, @template.category_id), include_blank: true %></p>
  <p><%= f.select :tracker_id, options_from_collection_for_select(Tracker.order(:position), :id, :name, @template.tracker_id), include_blank: l(:label_all) %></p>
  <p><%= f.check_box :is_default %></p>
  <p><%= f.check_box :is_public %></p>
  <p>
    <%= f.label :template_items, l(:label_checklist_template_items) %>
    <%= f.text_area :template_items, rows: 10, cols: 60, placeholder: "Item 1\n# Section Header\nItem 2" %>
    <em class="info"><%= l(:text_checklist_template_items_info) %></em>
  </p>
</div>
